# ---------------------------------------------------------------------------
# NEXORA environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, works with Railway/Vercel Postgres/Supabase/Neon) --
DATABASE_URL="postgresql://user:password@localhost:5432/nexora"

# --- App ---
# Set this to your REAL production domain before deploying -- it is used
# for canonical URLs, sitemap.xml, robots.txt, ads.txt, and Open Graph tags.
# "https://nexora.com" below is only a local-dev placeholder, not a real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth (session-based; see src/lib/auth.ts) ---
# 32+ byte random secret used to sign session cookies. Generate with:
# openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_COOKIE_NAME="nexora_session"

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, etc.) ---
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="nexora-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL="https://cdn.nexora.ai"

# --- Transactional email (see src/lib/email.ts; swap provider without touching callers) ---
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="NEXORA <newsletter@nexora.ai>"

# --- Analytics (see src/lib/analytics.ts) ---
ANALYTICS_PROVIDER="plausible"
ANALYTICS_ID="nexora.ai"
NEXT_PUBLIC_ANALYTICS_ID="nexora.ai"

# --- Advertising / Google AdSense (see src/components/monetization/AdSlot.tsx) ---
# Ads never render until ADS_ENABLED="true" AND both the client ID and the
# relevant per-placement slot ID below are set. See README.md "Google AdSense
# setup" for the full step-by-step process -- approval is NOT automatic or
# guaranteed, and this project does not (and cannot) claim AdSense approval.
ADS_ENABLED="false"
AD_PROVIDER="adsense"
# Your AdSense publisher/client ID, formatted "ca-pub-XXXXXXXXXXXXXXXX".
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Per-placement ad unit slot IDs from your AdSense account. Leave any of
# these blank to keep that specific placement disabled (Rule 11: conservative,
# non-flooding placement -- enable only the placements you actually want).
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=""
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_FEED=""
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_FEED=""

# --- Affiliate configuration (see src/lib/affiliate.ts) ---
AFFILIATE_TRACKING_PARAM="ref"
AFFILIATE_DEFAULT_TAG="nexora-20"

# --- Rate limiting (optional Redis-backed limiter; falls back to in-memory) ---
RATE_LIMIT_REDIS_URL=""
