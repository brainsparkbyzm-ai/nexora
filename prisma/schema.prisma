generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  author Author?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id   String  @id @default(cuid())
  slug String  @unique
  name String
  role String
  bio  String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  heroImage   String?

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  articles ArticleTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  content String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  status      ArticleStatus @default(DRAFT)
  featured    Boolean       @default(false)
  trending    Boolean       @default(false)
  readingTime Int
  heroImage   String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  schemaType     String?

  tags         ArticleTag[]
  relatedTools ArticleTool[]
  revisions    Revision[]
  viewEvents   ViewEvent[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([featured])
  @@index([trending])
  @@index([publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model ArticleTool {
  articleId String
  toolId    String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tool    Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([articleId, toolId])
  @@index([toolId])
}

model ToolCategory {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tools Tool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  websiteUrl  String
  pricing     String?

  rating   Float?
  pros     Json?
  cons     Json?
  bestFor  String?
  features Json?

  affiliateUrl        String?
  affiliateDisclosure String?
  lastReviewedAt      DateTime?
  featured            Boolean   @default(false)

  categoryId String
  category   ToolCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  comparisonsA Comparison[] @relation("ComparisonToolA")
  comparisonsB Comparison[] @relation("ComparisonToolB")
  winners      Comparison[] @relation("ComparisonWinner")

  review          Review?
  relatedArticles ArticleTool[]
  affiliateClicks AffiliateClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([slug])
}

model Review {
  id     String @id @default(cuid())
  toolId String @unique
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  rating  Float
  summary String?
  content String?
  pros    Json?
  cons    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comparison {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String

  toolAId String
  toolA   Tool   @relation("ComparisonToolA", fields: [toolAId], references: [id], onDelete: Restrict)

  toolBId String
  toolB   Tool   @relation("ComparisonToolB", fields: [toolBId], references: [id], onDelete: Restrict)

  winnerToolId String?
  winnerTool   Tool?   @relation("ComparisonWinner", fields: [winnerToolId], references: [id], onDelete: SetNull)

  featureTable Json
  verdict      String
  faq          Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Revision {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  title    String
  excerpt  String
  content  String
  editedBy String?

  createdAt DateTime @default(now())

  @@index([articleId])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  type      String?
  alt       String?
  title     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  createdAt DateTime @default(now())

  @@index([query])
}

model ViewEvent {
  id        String  @id @default(cuid())
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  path      String?
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([createdAt])
}

model AffiliateClick {
  id     String  @id @default(cuid())
  toolId String?
  tool   Tool?   @relation(fields: [toolId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([toolId])
}

model SiteSettings {
  id String @id

  siteName              String
  description           String
  defaultSeoTitle       String
  defaultSeoDescription String

  socialLinks Json

  newsletterEnabled Boolean @default(true)
  adsEnabled        Boolean @default(false)
  affiliateEnabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}